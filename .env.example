# Configuración de la API de Strapi (Catálogo de productos)
VITE_APP_STRAPI_BASE_URL=http://localhost:1337

# Configuración del Backend Node.js (Pedidos, Direcciones, Usuarios)
VITE_APP_BACKEND_API_URL=http://localhost:3000

# Clave pública de Stripe (obtener de https://dashboard.stripe.com/apikeys)
VITE_APP_STRIPE_PUBLIC_KEY=pk_test_tu_clave_publica_de_prueba

# Variables para producción (descomentar y configurar cuando sea necesario)
# VITE_APP_STRIPE_PUBLIC_KEY_PROD=pk_live_tu_clave_publica_de_produccion
# VITE_APP_STRAPI_BASE_URL_PROD=https://tu-api-strapi-produccion.com
# VITE_APP_BACKEND_API_URL_PROD=https://tu-api-backend-produccion.com
